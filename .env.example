# ─────────────────────────────────────────────────────────────────────
# .env.example
#
# This file documents all environment variables required by docker-compose.
# Copy this file to .env and fill in your real values before running.
#
#   cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────

# ── Mediation NeonDB ─────────────────────────────────────────────────
DB_URL=jdbc:postgresql://<neon-host>/<db-name>?sslmode=require
DB_USER=<neondb-username>
DB_PASSWORD=<neondb-password>

# ── FTP Server credentials ───────────────────────────────────────────
FTP_USER=testuser
FTP_PASS=testpass

# ── RMI service hostnames (Docker internal — do not change) ──────────
BILLING_RMI_HOST=billing
FRAUD_RMI_HOST=fraud
